# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rakshak

# Offline / Mock Database Mode (set to true to run offline without MongoDB Atlas)
USE_MOCK_DB=false

# Detector Mode (mock or real)
DETECTOR_MODE=mock

# JWT Secret & Configuration
JWT_SECRET=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Salt Secret for Access Log Pseudonymization
SALT_SECRET=replace_with_a_secure_random_salt_string_here

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Visualisation settings
SHOW_BOXES=true
FIGHT_DETECTION=true
